# =============================================================================
# ATS-Express — Variables de entorno (ejemplo)
# Copiar a .env y completar. NO commitear el .env real.
# =============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Supabase / Postgres -----------------------------------------------------
# DATABASE_URL: conexión con pooling (pgBouncer) para el runtime de la app.
#   En Supabase: Project Settings > Database > Connection string > "Transaction"
DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: conexión directa (puerto 5432) para Prisma Migrate.
DIRECT_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres"

# Claves de Supabase (el backend usa el SERVICE ROLE: bypassa RLS)
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_ANON_KEY="<anon-key>"
# JWT secret de Supabase (para validar tokens en NestJS)
SUPABASE_JWT_SECRET="<jwt-secret>"

# --- Pagos: MercadoPago ------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN="<access-token-sandbox>"
MERCADOPAGO_WEBHOOK_SECRET="<webhook-secret>"

# --- Mapas: Mapbox -----------------------------------------------------------
MAPBOX_TOKEN="<mapbox-token>"

# --- Notificaciones: WhatsApp API (reuso de otro proyecto ATS) ---------------
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
